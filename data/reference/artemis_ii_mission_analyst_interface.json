{
  "dataset_id": "phase8b_artemis_ii_mission_analyst_interface",
  "mission": "Artemis II",
  "phase": "8B",
  "status": "CITATION_FIRST_MISSION_ANALYST_COMPLETE",
  "purpose": "Compose evidence-grounded Artemis II answers from the Phase 8A retrieval layer, with claim-level citations and optional local/browser LLM presentation handoff.",
  "dependencies": [
    {
      "dataset_id": "phase8a_artemis_ii_mission_analyst_index",
      "path": "data/reference/artemis_ii_mission_analyst_index.json",
      "role": "structured retrieval and deterministic tools"
    },
    {
      "dataset_id": "phase7a_artemis_ii_mission_control_perspectives",
      "path": "data/reference/artemis_ii_mission_control_perspectives.json",
      "role": "discipline registry and shared event priorities"
    },
    {
      "dataset_id": "phase7b_artemis_ii_mission_control_decision_threads",
      "path": "data/reference/artemis_ii_decision_threads.json",
      "role": "decision threads and known/unknown boundaries"
    }
  ],
  "question_router": {
    "routes": [
      "EVENT_TIME",
      "EVENT",
      "DECISION_THREAD",
      "DECISION_THREAD_CAUSATION",
      "DISCIPLINE",
      "DETERMINISTIC_ELAPSED_TIME",
      "KNOWN_UNKNOWN",
      "SEARCH_SYNTHESIS"
    ],
    "deterministic": true,
    "llm_used_for_routing": false
  },
  "answer_contract": {
    "citation_first": true,
    "claim_level_citations_required": true,
    "unsupported_fact_invention_allowed": false,
    "known_unknown_state_supported": true,
    "provenance_labels_required": true,
    "deterministic_tools_may_be_used": true,
    "llm_required": false,
    "paid_model_required": false
  },
  "optional_llm_adapters": [
    {
      "adapter_id": "LOCAL_LLM_PROMPT_HANDOFF",
      "target": "local",
      "optional": true,
      "execution_embedded": false,
      "api_key_required": false,
      "paid_model_required": false,
      "description": "Export a locked evidence bundle and formatting prompt for an optional local model."
    },
    {
      "adapter_id": "BROWSER_LLM_PROMPT_HANDOFF",
      "target": "browser",
      "optional": true,
      "execution_embedded": false,
      "api_key_required": false,
      "paid_model_required": false,
      "description": "Export the same locked evidence bundle for optional browser-side model presentation."
    }
  ],
  "authority_model": {
    "deterministic_retrieval_is_authoritative": true,
    "deterministic_calculations_are_authoritative": true,
    "llm_may_rewrite_locked_claims": true,
    "llm_may_add_new_facts": false,
    "llm_may_override_evidence_boundaries": false,
    "llm_may_change_provenance": false,
    "llm_may_invent_citations": false
  },
  "known_unknown_policy": {
    "unknowns_are_answerable": true,
    "unknown_answer_must_state_boundary": true,
    "hypothesis_may_be_promoted_to_fact": false,
    "open_investigation_may_be_forced_closed": false,
    "missing_exact_time_may_be_invented": false
  },
  "sample_answer_count": 6,
